{
  "name": "prototyper",
  "version": "0.3.7",
  "description": "Daftarkan, jalankan, dan kelola prototype lokal agar bisa dikerjakan oleh LLM agent apa pun.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "prototyper": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch --exclude \"./examples/**\" src/cli/index.ts serve",
    "cli": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "schema": "tsx scripts/gen-schema.ts",
    "icon": "tsx scripts/gen-icon.ts",
    "start": "node dist/cli/index.js serve",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "commander": "^15.1.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "web",
    "schemas",
    "assets/tray"
  ]
}
